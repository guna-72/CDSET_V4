# AI Tutor Backend — Environment Variables Template
# Copy this file to .env and configure at least one Gemini API key.
# Get free keys at: https://aistudio.google.com/app/apikey

# Gemini API Keys (configured with Google AI Studio keys for automatic rotation & failover)
GEMINI_API_KEY_1=your_gemini_api_key_here
# GEMINI_API_KEY_2=your_gemini_api_key_2
# GEMINI_API_KEY_3=your_gemini_api_key_3

# Gemini model settings
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=12

# CORS — restrict to the frontend origin in production
ALLOWED_ORIGIN=http://127.0.0.1:5173
