# Dependencies
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
*/dist/
build/
*/build/

# Python cache & virtual environments
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
*/.venv/

# Testing & Coverage
.pytest_cache/
*/.pytest_cache/
.coverage
htmlcov/
tests-ui/.out/
*/tests-ui/.out/

# Environment files and credentials (protect API keys & secrets)
.env
.env.*
!.env.example
!.env.local_example
*.local

# Logs
logs/*.log
*.log

# Database and local user data
backend/data/*.db*
backend/data/storage/*
!backend/data/storage/.gitkeep
backend/data/workspace/*
!backend/data/workspace/.gitkeep

# Editor & OS files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Vite temporary files
vite.config.js.timestamp-*
*/vite.config.js.timestamp-*
