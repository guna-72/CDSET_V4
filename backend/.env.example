# Backend — Environment Variables Template
# Copy this file to .env and configure your environment.

# Optional external AI diagnosis. Keep secrets on the backend only.
ENABLE_LLM_DIAGNOSIS=true

# One key or many comma/newline separated keys per provider.
# OPENAI_API_KEYS=sk-...
# GROQ_API_KEYS=gsk_...
GEMINI_API_KEYS=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_API_KEYS=sk-ant-...
# DEEPSEEK_API_KEYS=sk-...
# OPENROUTER_API_KEYS=sk-or-...
# MISTRAL_API_KEYS=...
# COHERE_API_KEYS=...
# TOGETHER_API_KEYS=...
# XAI_API_KEYS=xai-...
# HUGGINGFACE_API_KEYS=hf_...

# Optional API token for protecting the backend.
# CHAOS_TUTOR_API_TOKEN=change-me

# Set only for a trusted local development machine where Linux namespace
# isolation is unavailable.
# CHAOS_TUTOR_ALLOW_DEGRADED_SANDBOX=false

# Optional Firebase Admin configuration.
# FIREBASE_AUTH_REQUIRED=false
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={...}
